<Window x:Class="McBoost.PclHook.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mcboost — PCL CE 下载加速" Height="620" Width="760"
        WindowStartupLocation="CenterScreen" Background="#FF1B1E24">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFD8DEE9"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#FF3B4252"/>
      <Setter Property="Foreground" Value="#FFECEFF4"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 标题 -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock FontSize="20" FontWeight="Bold" Text="mcboost — PCL CE 下载加速"/>
      <TextBlock FontSize="12" Foreground="#FF8891A4" Margin="0,4,0,0"
                 Text="突破 PCL CE 单文件 8 连接上限，实测同文件 2.7 → 18.3 MB/s"/>
    </StackPanel>

    <!-- 目标进程 -->
    <Border Grid.Row="1" Background="#FF23272F" CornerRadius="6" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="目标进程:" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock Grid.Column="1" x:Name="TxtProcess" VerticalAlignment="Center"
                   Text="未检测到 PCL CE" FontWeight="SemiBold"/>
        <Button Grid.Column="2" Content="刷新" Click="OnRefresh"/>
        <Button Grid.Column="3" Content="立即注入" Click="OnInject" Background="#FF4C7A5A"/>
      </Grid>
    </Border>

    <!-- 连接数设置 -->
    <Border Grid.Row="2" Background="#FF23272F" CornerRadius="6" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="单文件连接数"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Slider x:Name="SliderConnections" Minimum="8" Maximum="48" Value="24"
                  Width="300" VerticalAlignment="Center" TickFrequency="8"
                  IsSnapToTickEnabled="True"/>
          <TextBlock x:Name="TxtConnections" Text="24" Margin="12,0,0,0"
                     VerticalAlignment="Center" FontWeight="Bold" Width="30"/>
        </StackPanel>
        <TextBlock FontSize="11" Foreground="#FF8891A4" Margin="0,6,0,0"
                   Text="PCL CE 上限为 8；24 为实测较优值。过高可能被 CDN 限流。"/>
      </StackPanel>
    </Border>

    <!-- 自动注入开关 -->
    <Border Grid.Row="3" Background="#FF23272F" CornerRadius="6" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <CheckBox x:Name="ChkAuto" Content="开机自动运行并自动注入（检测到 PCL CE 启动即注入）"
                  Foreground="#FFD8DEE9" IsChecked="True"/>
        <CheckBox x:Name="ChkAutoRevert" Content="检测到 PCL CE 升级/更新时，自动停止注入并还原原版"
                  Foreground="#FFD8DEE9" IsChecked="True" Margin="0,6,0,0"/>
        <CheckBox x:Name="ChkStartMinimized" Content="启动到托盘（不显示主窗口）"
                  Foreground="#FFD8DEE9" IsChecked="False" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>

    <!-- 日志 -->
    <Border Grid.Row="4" Background="#FF23272F" CornerRadius="6" Padding="14" Margin="0,0,0,12">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBlock Text="日志" FontWeight="SemiBold"/>
          <Button Content="打开日志文件" Click="OnOpenLog" HorizontalAlignment="Right"
                  Padding="10,3" FontSize="11"/>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="TxtLog" FontFamily="Consolas" FontSize="11"
                     TextWrapping="Wrap" Foreground="#FFA3BE8C"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- 底部状态 -->
    <Grid Grid.Row="5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="TxtStatus" Grid.Column="0" VerticalAlignment="Center"
                 Foreground="#FF8891A4" Text="就绪"/>
      <Button Grid.Column="1" Content="退出" Click="OnExit"/>
    </Grid>
  </Grid>
</Window>
