<Window x:Class="McBoost.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mcboost — PCL CE 下载加速" Height="620" Width="720"
        WindowStartupLocation="CenterScreen" Background="#FF1B1E24">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock FontSize="20" FontWeight="Bold" Foreground="#FFECEFF4"
                 Text="mcboost — PCL CE 下载加速"/>
      <TextBlock FontSize="12" Foreground="#FF8891A4" Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="突破 PCL CE 单文件 8 连接上限（实测 2.7 → 18.3 MB/s）。用 .NET 官方启动钩子实现，不注入、不改下载源。"/>
    </StackPanel>

    <!-- PCL CE 路径 -->
    <Border Grid.Row="1" Background="#FF23272F" CornerRadius="6" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="PCL CE 主程序" Foreground="#FFD8DEE9" Margin="0,0,0,6"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" x:Name="TxtExePath" Padding="8,6"
                   Background="#FF2E3440" Foreground="#FFECEFF4" BorderThickness="0"
                   VerticalContentAlignment="Center"/>
          <Button Grid.Column="1" Content="浏览…" Click="OnBrowse"
                  Padding="14,6" Margin="8,0,0,0" Background="#FF3B4252"
                  Foreground="#FFECEFF4" BorderThickness="0"/>
          <Button Grid.Column="2" Content="自动检测" Click="OnAutoDetect"
                  Padding="14,6" Margin="6,0,0,0" Background="#FF3B4252"
                  Foreground="#FFECEFF4" BorderThickness="0"/>
        </Grid>
        <TextBlock x:Name="TxtDetectHint" FontSize="11" Foreground="#FF8891A4"
                   Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="找不到就点「浏览…」手动选 MultiMc.exe（PCL CE 主程序）。选择会被记住。"/>
      </StackPanel>
    </Border>

    <!-- 连接数 -->
    <Border Grid.Row="2" Background="#FF23272F" CornerRadius="6" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="每文件分片数（连接数）" Foreground="#FFD8DEE9"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Slider x:Name="SliderConnections" Minimum="4" Maximum="32" Value="8"
                  Width="280" IsSnapToTickEnabled="True" TickFrequency="8"/>
          <TextBlock x:Name="TxtConnections" Text="8" Foreground="#FFECEFF4"
                     Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <TextBlock FontSize="11" Foreground="#FF8891A4" Margin="0,6,0,0"
                   Text="PCL CE 2.15.x 硬编码每文件最多 4 个分片。8 为推荐值；过高可能被 CDN 限流。"/>
      </StackPanel>
    </Border>

    <!-- 操作 + 日志 -->
    <Border Grid.Row="3" Background="#FF23272F" CornerRadius="6" Padding="14" Margin="0,0,0,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
          <Button x:Name="BtnLaunch" Content="启动 PCL CE（已加速）" Click="OnLaunch"
                  Padding="16,9" Background="#FF4C7A5A" Foreground="#FFECEFF4" BorderThickness="0"/>
          <Button x:Name="BtnCheck" Content="检查状态" Click="OnCheck"
                  Padding="12,9" Margin="8,0,0,0" Background="#FF3B4252"
                  Foreground="#FFECEFF4" BorderThickness="0"/>
          <Button x:Name="BtnLog" Content="打开日志" Click="OnOpenLog"
                  Padding="12,9" Margin="8,0,0,0" Background="#FF3B4252"
                  Foreground="#FFECEFF4" BorderThickness="0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="TxtLog" FontFamily="Consolas" FontSize="11"
                     TextWrapping="Wrap" Foreground="#FFA3BE8C"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <TextBlock Grid.Row="4" x:Name="TxtStatus" Foreground="#FF8891A4" Text="就绪"/>
  </Grid>
</Window>
