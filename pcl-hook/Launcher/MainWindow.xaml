<Window x:Class="McBoost.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mcboost — PCL CE 下载加速" Height="560" Width="700"
        WindowStartupLocation="CenterScreen" Background="#FF1B1E24">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock FontSize="20" FontWeight="Bold" Foreground="#FFECEFF4"
                 Text="mcboost — PCL CE 下载加速"/>
      <TextBlock FontSize="12" Foreground="#FF8891A4" Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="突破 PCL CE 单文件 8 连接上限（实测同文件 2.7 → 18.3 MB/s）。不修改下载源、不注入进程，用 .NET 官方启动钩子实现。"/>
    </StackPanel>

    <Border Grid.Row="1" Background="#FF23272F" CornerRadius="6" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="连接数" Foreground="#FFD8DEE9"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Slider x:Name="SliderConnections" Minimum="8" Maximum="48" Value="24"
                  Width="280" IsSnapToTickEnabled="True" TickFrequency="8"/>
          <TextBlock x:Name="TxtConnections" Text="24" Foreground="#FFECEFF4"
                     Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
      <Button x:Name="BtnLaunch" Content="启动 PCL CE（已加速）" Click="OnLaunch"
              Padding="18,10" Background="#FF4C7A5A" Foreground="#FFECEFF4" BorderThickness="0"/>
      <Button x:Name="BtnCheck" Content="检查钩子状态" Click="OnCheck"
              Padding="14,10" Margin="8,0,0,0" Background="#FF3B4252" Foreground="#FFECEFF4" BorderThickness="0"/>
      <Button x:Name="BtnLog" Content="打开日志" Click="OnOpenLog"
              Padding="14,10" Margin="8,0,0,0" Background="#FF3B4252" Foreground="#FFECEFF4" BorderThickness="0"/>
    </StackPanel>

    <Border Grid.Row="3" Background="#FF23272F" CornerRadius="6" Padding="14" Margin="0,0,0,12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="状态 / 日志" Foreground="#FFD8DEE9" Margin="0,0,0,8"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="TxtLog" FontFamily="Consolas" FontSize="11"
                     TextWrapping="Wrap" Foreground="#FFA3BE8C"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <TextBlock Grid.Row="4" x:Name="TxtStatus" Foreground="#FF8891A4" Text="就绪"/>
  </Grid>
</Window>
